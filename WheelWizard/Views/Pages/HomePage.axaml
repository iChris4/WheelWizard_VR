<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:WheelWizard.Localization"
             xmlns:components="clr-namespace:WheelWizard.Views.Components"
             xmlns:behaviorComponent="clr-namespace:WheelWizard.Views.Patterns"
             mc:Ignorable="d" d:DesignWidth="490" d:DesignHeight="830"
             ClipToBounds="False"
             x:Class="WheelWizard.Views.Pages.HomePage">
    <UserControl.Styles>
        <Style Selector="components|WheelTrail.HoverEnterTrail">
            <Style.Animations>
                <Animation Duration="0:0:0.3" FillMode="Forward" Easing="ExponentialEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="ExtendedHeight" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ExtendedHeight" Value="-50" />
                    </KeyFrame>
                </Animation>
                <Animation Duration="0:0:3" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="WheelRotation" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="WheelRotation" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="components|WheelTrail.HoverExitTrail">
            <Style.Animations>
                <Animation Duration="0:0:0.8" FillMode="Forward" Easing="BounceEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="ExtendedHeight" Value="-50" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ExtendedHeight" Value="0" />
                    </KeyFrame>
                </Animation>
                <Animation Duration="0:0:0.8" FillMode="Forward" Easing="BounceEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="WheelRotation" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="WheelRotation" Value="100" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Home's game switch, the same segmented pill the Quest launcher shows above the title. -->
        <Style Selector="RadioButton.GameSegment">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Neutral300}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="999" Padding="12,5">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.GameSegment:pointerover">
            <Setter Property="Background" Value="{StaticResource Neutral800}" />
            <Setter Property="Foreground" Value="{StaticResource Neutral100}" />
        </Style>
        <Style Selector="RadioButton.GameSegment:pressed">
            <Setter Property="Background" Value="{StaticResource Neutral700}" />
        </Style>
        <Style Selector="RadioButton.GameSegment:checked">
            <Setter Property="Background" Value="{StaticResource Primary400}" />
            <Setter Property="Foreground" Value="{StaticResource Neutral950}" />
        </Style>

        <Style Selector="components|WheelTrail.ActivateTrailFromHover">
            <Style.Animations>
                <Animation Duration="0:0:0.6"
                           FillMode="Forward" Easing="CubicEaseIn">
                    <KeyFrame Cue="0%">
                        <Setter Property="ExtendedHeight" Value="-50" />
                        <Setter Property="WheelRotation" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ExtendedHeight" Value="-1200" />
                        <Setter Property="WheelRotation" Value="360" />
                        <Setter Property="IsVisible" Value="False" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        
        <Style Selector="components|WheelTrail.ActivateTrailFromIdle">
            <Style.Animations>
                <Animation Duration="0:0:0.6"
                           FillMode="Forward" Easing="CubicEaseIn">
                    <KeyFrame Cue="0%">
                        <Setter Property="ExtendedHeight" Value="0" />
                        <Setter Property="WheelRotation" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ExtendedHeight" Value="-1200" />
                        <Setter Property="WheelRotation" Value="360" />
                        <Setter Property="IsVisible" Value="False" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        
        <Style Selector="components|WheelTrail.EntranceTrail">
            <Style.Animations>
                <Animation Duration="0:0:0.6" Delay="0:0:0.3"
                           FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="ExtendedHeight" Value="250" />
                        <Setter Property="WheelRotation" Value="-200" />
                        <Setter Property="IsVisible" Value="True" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ExtendedHeight" Value="0" />
                        <Setter Property="WheelRotation" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        
    </UserControl.Styles>
    <Grid x:Name="CompleteGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource TopRowSize}" />
            <!-- This is the total height as the (Title + infoSection) - (padding) -->
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource BackgroundLineColor}" Height="1" HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom" />
        <TextBlock Grid.Row="0" Text="{loc:T page_title.home}" HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Classes="PageTitleText" />
        <Border Grid.Row="2" Background="{StaticResource BackgroundLineColor}" Height="1" HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom" />

        <Grid Grid.Row="2" ClipToBounds="True">
        <!-- These are invisible by default, they will be set to visible once the button is turned to green 
            This way we don't have to take in account whether or not an animation can play, since if it plays but it is not allowed, it will be invisible anyways -->
        <components:WheelTrail HorizontalAlignment="Left" VerticalAlignment="Top" x:Name="HomeTrail1"
                               Width="137" Angle="45" Y="-60" X="-20" ExtendedHeight="1000" IsVisible="False"
                               Background="{StaticResource Primary400}" Foreground="{StaticResource Primary700}" />
        <components:WheelTrail HorizontalAlignment="Left" VerticalAlignment="Top" x:Name="HomeTrail2"
                               Width="137" Angle="45" Y="-40" X="170" ExtendedHeight="1000" IsVisible="False"
                               Background="{StaticResource Primary600}" Foreground="{StaticResource Primary800}" />
        <components:WheelTrail HorizontalAlignment="Left" VerticalAlignment="Top" x:Name="HomeTrail3"
                               Width="137" Angle="45" Y="150" X="190" ExtendedHeight="1000" IsVisible="False"
                               Background="{StaticResource Primary200}" Foreground="{StaticResource Primary600}" />

        <Border Height="630" Width="250" CornerRadius="125,125,0,0" VerticalAlignment="Bottom"
                Background="{StaticResource FrameColor}" Margin="{StaticResource NegativeEdgeGap}">
            <PathIcon HorizontalAlignment="Center" VerticalAlignment="Top"
                      Data="{StaticResource WheelIcon}"
                      x:Name="WheelIcon"
                      Foreground="{StaticResource Neutral600}"
                      Width="200" Height="200" Margin="0,25" />
            <!-- 
                Note that this icon should have the same margin on each side. Decide a padding/border, enter that number in the margin at tb.
                Then, double this number, take the width of the parent container, and subtract the doubled margin. 
                This will give you the width & height of the icon.
            -->
        </Border>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="230" Margin="0,220" ZIndex="1">

            <Border x:Name="GameSelector" IsVisible="False"
                    HorizontalAlignment="Center" Margin="0,0,0,10"
                    BorderBrush="{StaticResource Neutral600}" BorderThickness="1"
                    CornerRadius="999" Padding="3">
                <StackPanel x:Name="GameSelectorSegments" Orientation="Horizontal" />
            </Border>

            <TextBlock TextAlignment="Center" TextWrapping="Wrap" Classes="TitleText" x:Name="GameTitle" />
            <TextBlock TextAlignment="Center" TextWrapping="Wrap" Classes="BodyText"
                       x:Name="BackendTitle" Margin="0,6,0,0" />
            <components:Button x:Name="PlayButton" MinWidth="180" MaxWidth="230" HorizontalAlignment="Center"
                               IsEnabled="True"
                               Variant="Primary"
                               Text="Play" PointerEntered="PlayButton_OnPointerEntered"
                               PointerExited="PlayButton_OnPointerExit"
                               IconData="{StaticResource Play}"
                               Click="PlayButton_Click"
                               Margin="0,20,0,0" />

            <!-- Normally we should not change the iconSize and/or Height since default is already correct
             But because the dolphin icon looks goofy that small, we can increase the size, and then change the size to be the default size again  -->
            <components:Button x:Name="DolphinButton"
                               IsEnabled="True"
                               IconData="{StaticResource DolphinIcon}"
                               IconSize="30"
                               Height="40"
                               Click="DolphinButton_OnClick"
                               Width="100" Margin="0,6,0,0" />
            <!-- removed tooltip for dolphin startup button as this doesn't look so nice, and I think everyone knows it by the dolphin icon -->
            <!-- ToolTip.Tip="{loc:T action.launch_dolphin}"
                               ToolTip.Placement="Top"
                               ToolTip.ShowDelay="50"  -->
        </StackPanel>
        
        <components:WheelTrail HorizontalAlignment="Right" VerticalAlignment="Bottom" x:Name="HomeTrail4"
                               Width="137" Angle="-35" X="-160" ExtendedHeight="1000" IsVisible="False"
                               Background="{StaticResource Primary400}" Foreground="{StaticResource Primary700}" />
        <components:WheelTrail HorizontalAlignment="Right" VerticalAlignment="Bottom" x:Name="HomeTrail5"
                               Width="137" Angle="-35" X="40" Y="30" ExtendedHeight="1000" IsVisible="False"
                               Background="{StaticResource Primary600}" Foreground="{StaticResource Primary800}" />
        </Grid>
    </Grid>
</UserControl>
